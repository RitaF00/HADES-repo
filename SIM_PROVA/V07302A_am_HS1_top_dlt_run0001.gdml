<?xml version="1.0" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
	<define>
		<constant name="TWOPI" value="2.*pi"/>
		<quantity name="wrap_top_thickness" value="1.0" type="length" unit="mm"/>
		<quantity name="wrap_z" value="100.0" type="length" unit="mm"/>
		<quantity name="wrap_cavity_radius" value="43.5" type="length" unit="mm"/>
		<quantity name="wrap_radius" value="44.2" type="length" unit="mm"/>
		<constant name="TWOPI_1" value="2.*pi"/>
		<quantity name="edge_height" value="1.3" type="length" unit="mm"/>
		<quantity name="pos_top_ring_z" value="40.0" type="length" unit="mm"/>
		<quantity name="end_top_ring_z" value="48.6" type="length" unit="mm"/>
		<quantity name="pos_bottom_ring_z" value="64.4" type="length" unit="mm"/>
		<quantity name="end_bottom_ring_z" value="73.0" type="length" unit="mm"/>
		<quantity name="inner_height" value="105.0" type="length" unit="mm"/>
		<quantity name="outer_height" value="108.1" type="length" unit="mm"/>
		<quantity name="end_bottom_cyl_inner_z" value="120.9" type="length" unit="mm"/>
		<quantity name="end_bottom_cyl_outer_z" value="133.5" type="length" unit="mm"/>
		<quantity name="inner_radius" value="44.5" type="length" unit="mm"/>
		<quantity name="bottom_cyl_inner_radius" value="8.0" type="length" unit="mm"/>
		<quantity name="max_radius" value="47.5" type="length" unit="mm"/>
		<quantity name="outer_radius" value="45.3" type="length" unit="mm"/>
		<quantity name="bottom_cyl_outer_radius" value="13.0" type="length" unit="mm"/>
		<constant name="TWOPI_2" value="2.*pi"/>
		<quantity name="start_cavity_z" value="1.5" type="length" unit="mm"/>
		<quantity name="end_cavity_z" value="(171.0-0.8)" type="length" unit="mm"/>
		<quantity name="cryostat_z" value="171.0" type="length" unit="mm"/>
		<quantity name="cryostat_cavity_radius" value="(114.3-2*1.5)/2" type="length" unit="mm"/>
		<quantity name="cryostat_radius" value="114.3/2" type="length" unit="mm"/>
		<quantity name="collimator_beam_radius" value="1.0/2" type="length" unit="mm"/>
		<quantity name="collimator_beam_z" value="25.6" type="length" unit="mm"/>
		<constant name="TWOPI_3" value="2.*pi"/>
		<quantity name="collimator_z" value="65.0" type="length" unit="mm"/>
		<position name="pos_collimator_beam" x="0.0" y="0.0" z="(collimator_z-collimator_beam_z)/2" unit="mm"/>
		<quantity name="source_radius" value="1.0/2" type="length" unit="mm"/>
		<quantity name="source_z" value="2.0" type="length" unit="mm"/>
		<quantity name="source_capsule_z" value="10.0" type="length" unit="mm"/>
		<quantity name="window" value="0.2" type="length" unit="mm"/>
		<position name="pos_source_capsule" x="0.0" y="0.0" z="(source_capsule_z-source_z)/2-window" unit="mm"/>
		<quantity name="source_capsule_radius" value="2.0/2" type="length" unit="mm"/>
		<position name="pos_source_collimator" x="0.0" y="0.0" z="(-source_capsule_z/ 2. - collimator_beam_z + collimator_z / 2.)" unit="mm"/>
		<quantity name="collimator_x" value="30.0" type="length" unit="mm"/>
		<quantity name="collimator_y" value="30.0" type="length" unit="mm"/>
	</define>
	<materials>
		<element name="Hydrogen" formula="H" Z="1">
			<atom value="1.0"/>
		</element>
		<element name="Carbon" formula="C" Z="6">
			<atom value="12.01"/>
		</element>
		<material name="HD1000">
			<D value="0.93"/>
			<composite ref="Hydrogen" n="4"/>
			<composite ref="Carbon" n="2"/>
		</material>
		<element name="Copper" formula="Cu" Z="29">
			<atom value="63.546"/>
		</element>
		<element name="Lead" formula="Pb" Z="82">
			<atom value="207.2"/>
		</element>
		<element name="Bismuth" formula="Bi" Z="83">
			<atom value="208.98"/>
		</element>
		<element name="Aluminium" formula="Al" Z="13">
			<atom value="26.98"/>
		</element>
		<material name="EN_AW-2011T8">
			<D value="2.84"/>
			<fraction ref="Copper" n="0.06"/>
			<fraction ref="Lead" n="0.004"/>
			<fraction ref="Bismuth" n="0.004"/>
			<fraction ref="Aluminium" n="0.932"/>
		</material>
		<isotope name="Ge74" Z="32" N="74">
			<atom value="73.921"/>
		</isotope>
		<isotope name="Ge76" Z="32" N="76">
			<atom value="75.921"/>
		</isotope>
		<element name="ElementEnrichedGermanium0.900" formula="EnrGe0.900">
			<fraction ref="Ge74" n="0.09999999999999998"/>
			<fraction ref="Ge76" n="0.9"/>
		</element>
		<material name="EnrichedGermanium0.900">
			<D value="5.550156934963668"/>
			<fraction ref="ElementEnrichedGermanium0.900" n="1"/>
		</material>
		<element name="Copper_0" formula="Cu" Z="29">
			<atom value="63.546"/>
		</element>
		<element name="Lead_0" formula="Pb" Z="82">
			<atom value="207.2"/>
		</element>
		<element name="Bismuth_0" formula="Bi" Z="83">
			<atom value="208.98"/>
		</element>
		<element name="Aluminium_0" formula="Al" Z="13">
			<atom value="26.98"/>
		</element>
		<material name="EN_AW-2011T8_0">
			<D value="2.84"/>
			<fraction ref="Copper_0" n="0.06"/>
			<fraction ref="Lead_0" n="0.004"/>
			<fraction ref="Bismuth_0" n="0.004"/>
			<fraction ref="Aluminium_0" n="0.932"/>
		</material>
		<element name="Carbon_0" formula="C" Z="6">
			<atom value="12.01"/>
		</element>
		<element name="Nitrogen" formula="N" Z="7">
			<atom value="14.01"/>
		</element>
		<element name="Oxygen" formula="O" Z="8">
			<atom value="16.0"/>
		</element>
		<element name="Argon" formula="Ar" Z="18">
			<atom value="39.95"/>
		</element>
		<material name="Air">
			<D value="0.00120479"/>
			<fraction ref="Carbon_0" n="0.000124"/>
			<fraction ref="Nitrogen" n="0.755268"/>
			<fraction ref="Oxygen" n="0.231781"/>
			<fraction ref="Argon" n="0.012827"/>
		</material>
		<element name="Silicon" formula="Si" Z="14">
			<atom value="28.09"/>
		</element>
		<material name="SiliconDioxide">
			<D value="2.32"/>
			<composite ref="Silicon" n="1"/>
			<composite ref="Oxygen" n="2"/>
		</material>
		<element name="Chromium" formula="Cr" Z="24">
			<atom value="51.9961"/>
		</element>
		<element name="Manganese" formula="Mn" Z="25">
			<atom value="54.93805"/>
		</element>
		<element name="Iron" formula="Fe" Z="26">
			<atom value="55.845"/>
		</element>
		<element name="Nickel" formula="Ni" Z="28">
			<atom value="58.9332"/>
		</element>
		<material name="Ssteel">
			<D value="7.9"/>
			<fraction ref="Silicon" n="0.01"/>
			<fraction ref="Chromium" n="0.2"/>
			<fraction ref="Manganese" n="0.02"/>
			<fraction ref="Iron" n="0.67"/>
			<fraction ref="Nickel" n="0.10"/>
		</material>
	</materials>
	<solids>
		<box name="world" x="20" y="20" z="20" lunit="m"/>
		<box name="lab" x="18" y="18" z="18" lunit="m"/>
		<genericPolycone name="vacuum_cavity" startphi="0.0" deltaphi="6.283185307179586" lunit="mm" aunit="rad">
			<rzpoint r="0.0" z="0.0"/>
			<rzpoint r="55.65" z="0.0"/>
			<rzpoint r="55.65" z="168.7"/>
			<rzpoint r="0.0" z="168.7"/>
		</genericPolycone>
		<polycone name="wrap" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad">
			<zplane rmin="0" rmax="wrap_radius" z="0"/>
			<zplane rmin="0" rmax="wrap_radius" z="wrap_top_thickness"/>
			<zplane rmin="wrap_cavity_radius" rmax="wrap_radius" z="wrap_top_thickness"/>
			<zplane rmin="wrap_cavity_radius" rmax="wrap_radius" z="wrap_z"/>
		</polycone>
		<polycone name="holder" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad">
			<zplane rmin="inner_radius" rmax="max_radius" z="0"/>
			<zplane rmin="inner_radius" rmax="max_radius" z="edge_height"/>
			<zplane rmin="inner_radius" rmax="outer_radius" z="edge_height"/>
			<zplane rmin="inner_radius" rmax="outer_radius" z="pos_top_ring_z"/>
			<zplane rmin="inner_radius" rmax="max_radius" z="pos_top_ring_z"/>
			<zplane rmin="inner_radius" rmax="max_radius" z="end_top_ring_z"/>
			<zplane rmin="inner_radius" rmax="outer_radius" z=" end_top_ring_z"/>
			<zplane rmin="inner_radius" rmax="outer_radius" z="pos_bottom_ring_z"/>
			<zplane rmin="inner_radius" rmax="max_radius" z="pos_bottom_ring_z"/>
			<zplane rmin="inner_radius" rmax="max_radius" z="end_bottom_ring_z"/>
			<zplane rmin="inner_radius" rmax="outer_radius" z="end_bottom_ring_z"/>
			<zplane rmin="inner_radius" rmax="outer_radius" z="inner_height"/>
			<zplane rmin="bottom_cyl_inner_radius" rmax="outer_radius" z="inner_height"/>
			<zplane rmin="bottom_cyl_inner_radius" rmax="outer_radius" z="outer_height"/>
			<zplane rmin="bottom_cyl_inner_radius" rmax="bottom_cyl_outer_radius" z="outer_height"/>
			<zplane rmin="bottom_cyl_inner_radius" rmax="bottom_cyl_outer_radius" z="end_bottom_cyl_inner_z"/>
			<zplane rmin="0" rmax="bottom_cyl_outer_radius" z="end_bottom_cyl_inner_z"/>
			<zplane rmin="0" rmax="bottom_cyl_outer_radius" z="end_bottom_cyl_outer_z"/>
		</polycone>
		<genericPolycone name="V03421A" startphi="0" deltaphi="6.283185307179586" lunit="mm" aunit="rad">
			<rzpoint r="0" z="0"/>
			<rzpoint r="12" z="0"/>
			<rzpoint r="12" z="2"/>
			<rzpoint r="15" z="2"/>
			<rzpoint r="15" z="0"/>
			<rzpoint r="42.0" z="0"/>
			<rzpoint r="43" z="1"/>
			<rzpoint r="43" z="84.2"/>
			<rzpoint r="42.0" z="85.2"/>
			<rzpoint r="4" z="85.2"/>
			<rzpoint r="4" z="40.2"/>
			<rzpoint r="0" z="40.2"/>
		</genericPolycone>
		<polycone name="cryostat" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad">
			<zplane rmin="0" rmax="cryostat_radius" z="0"/>
			<zplane rmin="0" rmax="cryostat_radius" z="start_cavity_z"/>
			<zplane rmin="cryostat_cavity_radius" rmax="cryostat_radius" z="start_cavity_z"/>
			<zplane rmin="cryostat_cavity_radius" rmax="cryostat_radius" z="end_cavity_z"/>
			<zplane rmin="0" rmax="cryostat_radius" z="end_cavity_z"/>
			<zplane rmin="0" rmax="cryostat_radius" z="cryostat_z"/>
		</polycone>
		<tube name="collimator_beam" rmin="0" rmax="collimator_beam_radius" z="collimator_beam_z" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad"/>
		<tube name="source" rmin="0" rmax="source_radius" z="source_z" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad"/>
		<tube name="source_capsule" rmin="0" rmax="source_capsule_radius" z="source_capsule_z" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad"/>
		<box name="collimator" x="collimator_x" y="collimator_y" z="collimator_z" lunit="mm"/>
	</solids>
	<structure>
		<volume name="Wrap">
			<materialref ref="HD1000"/>
			<solidref ref="wrap"/>
		</volume>
		<volume name="Holder">
			<materialref ref="EN_AW-2011T8"/>
			<solidref ref="holder"/>
		</volume>
		<volume name="V03421A">
			<materialref ref="EnrichedGermanium0.900"/>
			<solidref ref="V03421A"/>
		</volume>
		<volume name="cavity_lv">
			<materialref ref="G4_Galactic"/>
			<solidref ref="vacuum_cavity"/>
			<physvol name="wrap_pv_1">
				<volumeref ref="Wrap"/>
				<position name="wrap_pv_pos" x="0.000000000000000" y="0.000000000000000" z="16.500000000000000" unit="mm"/>
			</physvol>
			<physvol name="holder_pv_1">
				<volumeref ref="Holder"/>
				<position name="holder_pv_pos" x="0.000000000000000" y="0.000000000000000" z="16.500000000000000" unit="mm"/>
			</physvol>
			<physvol name="V03421A">
				<volumeref ref="V03421A"/>
				<position name="V03421A_pos" x="0.000000000000000" y="0.000000000000000" z="102.700000000000003" unit="mm"/>
				<rotation name="V03421A_rot" x="0.000000000000000" y="3.141592653589793" z="0.000000000000000" unit="rad"/>
			</physvol>
		</volume>
		<volume name="Cryostat">
			<materialref ref="EN_AW-2011T8_0"/>
			<solidref ref="cryostat"/>
		</volume>
		<volume name="Collimator_Beam">
			<materialref ref="Air"/>
			<solidref ref="collimator_beam"/>
		</volume>
		<volume name="Source">
			<materialref ref="SiliconDioxide"/>
			<solidref ref="source"/>
		</volume>
		<volume name="Source_Encapsulated">
			<materialref ref="Ssteel"/>
			<solidref ref="source_capsule"/>
			<physvol name="Source_PV">
				<volumeref ref="Source"/>
				<positionref ref="pos_source_capsule"/>
			</physvol>
		</volume>
		<volume name="Source_Collimated">
			<materialref ref="G4_Cu"/>
			<solidref ref="collimator"/>
			<physvol name="Collimator_Beam_PV">
				<volumeref ref="Collimator_Beam"/>
				<positionref ref="pos_collimator_beam"/>
			</physvol>
			<physvol name="Source_Encapsulated_PV">
				<volumeref ref="Source_Encapsulated"/>
				<positionref ref="pos_source_collimator"/>
			</physvol>
		</volume>
		<volume name="lab_lv">
			<materialref ref="G4_AIR"/>
			<solidref ref="lab"/>
			<physvol name="cavity_pv">
				<volumeref ref="cavity_lv"/>
				<position name="cavity_pv_pos" x="0.000000000000000" y="0.000000000000000" z="1.500000000000000" unit="mm"/>
			</physvol>
			<physvol name="cryo_pv_1">
				<volumeref ref="Cryostat"/>
			</physvol>
			<physvol name="source_pv_1">
				<volumeref ref="Source_Collimated"/>
				<position name="source_pv_pos" x="-22.000000000000000" y="-0.000000000000000" z="-37.500000000000000" unit="mm"/>
			</physvol>
		</volume>
		<volume name="world_lv">
			<materialref ref="G4_Galactic"/>
			<solidref ref="world"/>
			<physvol name="lab">
				<volumeref ref="lab_lv"/>
				<rotation name="lab_rot" x="0.000000000000000" y="3.141592653589793" z="0.000000000000000" unit="rad"/>
			</physvol>
		</volume>
	</structure>
	<setup name="Default" version="1.0">
		<world ref="world_lv"/>
	</setup>
</gdml>
