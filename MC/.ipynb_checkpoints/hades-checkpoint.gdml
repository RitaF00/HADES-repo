			<solidref ref="collimator_beam"/>
		</volume>
		<volume name="Source">
			<materialref ref="SiliconDioxide"/>
			<solidref ref="source"/>
			<auxiliary auxtype="rmg_color" auxvalue="1,0,0,0.9"/>
		</volume>
		<volume name="Source_Encapsulated">
			<materialref ref="Ssteel"/>
			<solidref ref="source_capsule"/>
			<physvol name="Source_PV">
				<volumeref ref="Source"/>
				<positionref ref="pos_source_capsule"/>
			</physvol>
		</volume>
		<volume name="Source_Collimated">
			<materialref ref="G4_Cu"/>
			<solidref ref="collimator"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.66,0.44,0.26,0.5"/>
			<physvol name="Collimator_Beam_PV">
				<volumeref ref="Collimator_Beam"/>
				<positionref ref="pos_collimator_beam"/>
			</physvol>
			<physvol name="Source_Encapsulated_PV">
				<volumeref ref="Source_Encapsulated"/>
				<positionref ref="pos_source_collimator"/>
			</physvol>
		</volume>
		<volume name="lab_lv">
			<materialref ref="G4_AIR"/>
			<solidref ref="lab"/>
			<auxiliary auxtype="rmg_color" auxvalue="-1"/>
			<physvol name="cavity_pv">
				<volumeref ref="cavity_lv"/>
				<position name="cavity_pv_pos" x="0.000000000000000" y="0.000000000000000" z="1.500000000000000" unit="mm"/>
			</physvol>
			<physvol name="cryo_pv_1">
				<volumeref ref="Cryostat"/>
			</physvol>
			<physvol name="source_pv_1">
				<volumeref ref="Source_Collimated"/>
				<position name="source_pv_pos" x="-22.000000000000000" y="-0.000000000000000" z="-37.500000000000000" unit="mm"/>
			</physvol>
		</volume>
		<volume name="world_lv">
			<materialref ref="G4_Galactic"/>
			<solidref ref="world"/>
			<physvol name="lab">
				<volumeref ref="lab_lv"/>
				<rotation name="lab_rot" x="0.000000000000000" y="3.141592653589793" z="0.000000000000000" unit="rad"/>
			</physvol>
		</volume>
	</structure>
