		<quantity name="outer_radius" value="45.3" type="length" unit="mm"/>
		<quantity name="bottom_cyl_outer_radius" value="13.0" type="length" unit="mm"/>
		<constant name="TWOPI_2" value="2.*pi"/>
		<quantity name="start_cavity_z" value="1.5" type="length" unit="mm"/>
		<quantity name="end_cavity_z" value="(171.0-0.8)" type="length" unit="mm"/>
		<quantity name="cryostat_z" value="171.0" type="length" unit="mm"/>
		<quantity name="cryostat_cavity_radius" value="(114.3-2*1.5)/2" type="length" unit="mm"/>
		<quantity name="cryostat_radius" value="114.3/2" type="length" unit="mm"/>
		<quantity name="collimator_beam_radius" value="1.0/2" type="length" unit="mm"/>
		<quantity name="collimator_beam_z" value="25.6" type="length" unit="mm"/>
		<constant name="TWOPI_3" value="2.*pi"/>
		<quantity name="collimator_z" value="65.0" type="length" unit="mm"/>
		<position name="pos_collimator_beam" x="0.0" y="0.0" z="(collimator_z-collimator_beam_z)/2" unit="mm"/>
		<quantity name="source_radius" value="1.0/2" type="length" unit="mm"/>
		<quantity name="source_z" value="2.0" type="length" unit="mm"/>
		<quantity name="source_capsule_z" value="10.0" type="length" unit="mm"/>
		<quantity name="window" value="0.2" type="length" unit="mm"/>
		<position name="pos_source_capsule" x="0.0" y="0.0" z="(source_capsule_z-source_z)/2-window" unit="mm"/>
		<quantity name="source_capsule_radius" value="2.0/2" type="length" unit="mm"/>
		<position name="pos_source_collimator" x="0.0" y="0.0" z="(-source_capsule_z/ 2. - collimator_beam_z + collimator_z / 2.)" unit="mm"/>
		<quantity name="collimator_x" value="30.0" type="length" unit="mm"/>
		<quantity name="collimator_y" value="30.0" type="length" unit="mm"/>
	</define>
	<materials>
