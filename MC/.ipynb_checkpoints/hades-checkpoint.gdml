			<rzpoint r="4" z="85.2"/>
			<rzpoint r="4" z="40.2"/>
			<rzpoint r="0" z="40.2"/>
		</genericPolycone>
		<polycone name="cryostat" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad">
