			<zplane rmin="cryostat_cavity_radius" rmax="cryostat_radius" z="end_cavity_z"/>
			<zplane rmin="0" rmax="cryostat_radius" z="end_cavity_z"/>
			<zplane rmin="0" rmax="cryostat_radius" z="cryostat_z"/>
		</polycone>
		<tube name="collimator_beam" rmin="0" rmax="collimator_beam_radius" z="collimator_beam_z" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad"/>
		<tube name="source" rmin="0" rmax="source_radius" z="source_z" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad"/>
		<tube name="source_capsule" rmin="0" rmax="source_capsule_radius" z="source_capsule_z" startphi="0" deltaphi="TWOPI" lunit="mm" aunit="rad"/>
		<box name="collimator" x="collimator_x" y="collimator_y" z="collimator_z" lunit="mm"/>
